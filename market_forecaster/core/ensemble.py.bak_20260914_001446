"""Production ensemble: ARIMA + RandomForest + Ridge (+ optional LSTM).

All model weights are derived from the same held-out validation window. Forecast
intervals use split-conformal absolute residuals from that validation window rather
than cross-model disagreement.
"""

from __future__ import annotations

import logging
import os
from dataclasses import dataclass
from typing import Optional

import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.linear_model import Ridge
from sklearn.preprocessing import MinMaxScaler, StandardScaler

from market_forecaster.core.data import get_close_series, infer_forecast_freq

logger = logging.getLogger(__name__)

try:
    from statsmodels.tsa.arima.model import ARIMA
    ARIMA_AVAILABLE = True
except ImportError:
    ARIMA_AVAILABLE = False

try:
    import tensorflow as tf
    from tensorflow.keras.callbacks import EarlyStopping
    from tensorflow.keras.layers import Dense, Dropout, LSTM as KerasLSTM
    from tensorflow.keras.models import Sequential

    tf.get_logger().setLevel("ERROR")
    tf.random.set_seed(42)
    LSTM_AVAILABLE = True
except ImportError:
    LSTM_AVAILABLE = False


@dataclass
class ValidationSummary:
    errors: dict[str, float]
    weights: dict[str, float]
    residuals: np.ndarray
    size: int


def _smape(y_true: np.ndarray, y_pred: np.ndarray) -> float:
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)
    denom = (np.abs(y_true) + np.abs(y_pred)) / 2
    mask = np.isfinite(y_true) & np.isfinite(y_pred) & (denom > 0)
    if not mask.any():
        return float("inf")
    return float(np.mean(np.abs(y_true[mask] - y_pred[mask]) / denom[mask]) * 100)


def _normalized_inverse_error_weights(errors: dict[str, float]) -> dict[str, float]:
    valid = {k: v for k, v in errors.items() if np.isfinite(v) and v >= 0}
    if not valid:
        return {}
    raw = {k: 1.0 / max(v, 0.25) for k, v in valid.items()}
    total = sum(raw.values())
    return {k: v / total for k, v in raw.items()}


class EnsembleForecaster:
    def __init__(self, weights: Optional[dict] = None, *, enable_lstm: bool = False):
        self.initial_weights = weights or {"arima": 0.30, "rf": 0.35, "ridge": 0.35}
        self.enable_lstm = bool(enable_lstm and LSTM_AVAILABLE)
        self.lookback = 20
        self.lstm_lookback = 60

        self.arima_model = None
        self.rf_model = None
        self.ridge_model = None
        self.lstm_model = None

        self.rf_scaler = StandardScaler()
        self.ridge_scaler = StandardScaler()
        self.lstm_scaler = MinMaxScaler()

        self.rf_last_values: Optional[np.ndarray] = None
        self.ridge_last_values: Optional[np.ndarray] = None
        self.lstm_last_seq: Optional[np.ndarray] = None
        self.validation_errors: dict[str, float] = {}

    @staticmethod
    def _lag_matrix(series: pd.Series, lookback: int) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
        clean = pd.to_numeric(series, errors="coerce").dropna().to_numpy(dtype=float)
        if len(clean) < lookback + 10:
            raise ValueError("Insufficient data for lag model")
        X = np.vstack([clean[i - lookback:i] for i in range(lookback, len(clean))])
        y = clean[lookback:]
        return X, y, clean

    def fit_arima(self, series: pd.Series, order: tuple[int, int, int] = (5, 1, 0)):
        if not ARIMA_AVAILABLE:
            return None
        clean = pd.to_numeric(series, errors="coerce").dropna()
        if len(clean) < 40:
            return None
        try:
            self.arima_model = ARIMA(clean, order=order).fit()
            return self.arima_model
        except Exception as exc:
            logger.warning("arima_fit_failed error=%s", exc)
            return None

    def fit_rf(self, series: pd.Series):
        try:
            X, y, clean = self._lag_matrix(series, self.lookback)
            Xs = self.rf_scaler.fit_transform(X)
            self.rf_model = RandomForestRegressor(
                n_estimators=300,
                max_depth=12,
                min_samples_leaf=2,
                min_samples_split=5,
                random_state=42,
                n_jobs=-1,
            )
            self.rf_model.fit(Xs, y)
            self.rf_last_values = clean[-self.lookback:]
            return self.rf_model
        except Exception as exc:
            logger.warning("rf_fit_failed error=%s", exc)
            return None

    def fit_ridge(self, series: pd.Series):
        try:
            X, y, clean = self._lag_matrix(series, self.lookback)
            Xs = self.ridge_scaler.fit_transform(X)
            self.ridge_model = Ridge(alpha=1.0)
            self.ridge_model.fit(Xs, y)
            self.ridge_last_values = clean[-self.lookback:]
            return self.ridge_model
        except Exception as exc:
            logger.warning("ridge_fit_failed error=%s", exc)
            return None

    def fit_lstm(self, series: pd.Series):
        if not self.enable_lstm:
            return None
        try:
            clean = pd.to_numeric(series, errors="coerce").dropna().to_numpy(dtype=float).reshape(-1, 1)
            if len(clean) < self.lstm_lookback + 40:
                return None
            scaled = self.lstm_scaler.fit_transform(clean)
            X = np.array([scaled[i - self.lstm_lookback:i, 0] for i in range(self.lstm_lookback, len(scaled))])
            y = scaled[self.lstm_lookback:, 0]
            X = X.reshape((X.shape[0], X.shape[1], 1))
            model = Sequential([
                KerasLSTM(48, return_sequences=True, input_shape=(X.shape[1], 1)),
                Dropout(0.2),
                KerasLSTM(32),
                Dropout(0.2),
                Dense(16, activation="relu"),
                Dense(1),
            ])
            model.compile(optimizer="adam", loss="mean_squared_error")
            callbacks = [EarlyStopping(monitor="val_loss", patience=5, restore_best_weights=True)]
            model.fit(X, y, epochs=50, batch_size=32, validation_split=0.15, callbacks=callbacks, verbose=0)
            self.lstm_model = model
            self.lstm_last_seq = scaled[-self.lstm_lookback:]
            return model
        except Exception as exc:
            logger.warning("lstm_fit_failed error=%s", exc)
            return None

    def fit_all(self, series: pd.Series):
        self.fit_arima(series)
        self.fit_rf(series)
        self.fit_ridge(series)
        if self.enable_lstm:
            self.fit_lstm(series)
        return self

    def predict_arima(self, steps: int) -> Optional[np.ndarray]:
        if self.arima_model is None:
            return None
        try:
            return np.asarray(self.arima_model.forecast(steps=steps), dtype=float)
        except Exception as exc:
            logger.warning("arima_predict_failed error=%s", exc)
            return None

    @staticmethod
    def _recursive_lag_predict(model, scaler, last_values: np.ndarray, lookback: int, steps: int) -> np.ndarray:
        current = np.asarray(last_values, dtype=float).copy()
        preds: list[float] = []
        for _ in range(steps):
            X = current[-lookback:].reshape(1, -1)
            pred = float(model.predict(scaler.transform(X))[0])
            preds.append(pred)
            current = np.append(current, pred)
        return np.asarray(preds)

    def predict_rf(self, steps: int) -> Optional[np.ndarray]:
        if self.rf_model is None or self.rf_last_values is None:
            return None
        try:
            return self._recursive_lag_predict(self.rf_model, self.rf_scaler, self.rf_last_values, self.lookback, steps)
        except Exception as exc:
            logger.warning("rf_predict_failed error=%s", exc)
            return None

    def predict_ridge(self, steps: int) -> Optional[np.ndarray]:
        if self.ridge_model is None or self.ridge_last_values is None:
            return None
        try:
            return self._recursive_lag_predict(self.ridge_model, self.ridge_scaler, self.ridge_last_values, self.lookback, steps)
        except Exception as exc:
            logger.warning("ridge_predict_failed error=%s", exc)
            return None

    def predict_lstm(self, steps: int) -> Optional[np.ndarray]:
        if self.lstm_model is None or self.lstm_last_seq is None:
            return None
        try:
            seq = self.lstm_last_seq.copy()
            preds: list[float] = []
            for _ in range(steps):
                value = float(self.lstm_model.predict(seq.reshape(1, self.lstm_lookback, 1), verbose=0)[0, 0])
                preds.append(value)
                seq = np.append(seq[1:], [[value]], axis=0)
            return self.lstm_scaler.inverse_transform(np.asarray(preds).reshape(-1, 1)).ravel()
        except Exception as exc:
            logger.warning("lstm_predict_failed error=%s", exc)
            return None

    def individual_predictions(self, steps: int) -> dict[str, np.ndarray]:
        result: dict[str, np.ndarray] = {}
        for name, fn in (
            ("arima", self.predict_arima),
            ("rf", self.predict_rf),
            ("ridge", self.predict_ridge),
            ("lstm", self.predict_lstm),
        ):
            pred = fn(steps)
            if pred is not None and len(pred) == steps and np.isfinite(pred).all():
                result[name] = pred
        return result

    def current_weights(self, available: list[str]) -> dict[str, float]:
        if self.validation_errors:
            weights = _normalized_inverse_error_weights({k: self.validation_errors[k] for k in available if k in self.validation_errors})
            if weights:
                return weights
        fallback = {k: float(self.initial_weights.get(k, 1.0)) for k in available}
        total = sum(fallback.values()) or 1.0
        return {k: v / total for k, v in fallback.items()}

    def predict_ensemble(self, steps: int) -> tuple[Optional[np.ndarray], dict[str, np.ndarray], dict[str, float]]:
        predictions = self.individual_predictions(steps)
        if not predictions:
            return None, {}, {}
        weights = self.current_weights(list(predictions))
        ensemble = sum(weights[name] * pred for name, pred in predictions.items())
        return np.asarray(ensemble), predictions, weights


def _validate(series: pd.Series, *, enable_lstm: bool, initial_weights: Optional[dict]) -> ValidationSummary:
    clean = pd.to_numeric(series, errors="coerce").dropna().reset_index(drop=True)
    if len(clean) < 120:
        return ValidationSummary(errors={}, weights={}, residuals=np.array([]), size=0)

    val_size = min(30, max(12, len(clean) // 8))
    train, actual = clean.iloc[:-val_size], clean.iloc[-val_size:].to_numpy(dtype=float)
    validator = EnsembleForecaster(initial_weights, enable_lstm=enable_lstm).fit_all(train)
    preds = validator.individual_predictions(val_size)
    errors = {name: _smape(actual, pred) for name, pred in preds.items()}
    weights = _normalized_inverse_error_weights(errors)
    if not weights:
        return ValidationSummary(errors=errors, weights={}, residuals=np.array([]), size=val_size)

    ensemble_val = sum(weights[name] * preds[name] for name in weights)
    residuals = actual - ensemble_val
    return ValidationSummary(errors=errors, weights=weights, residuals=residuals, size=val_size)


def _conformal_interval(ensemble: np.ndarray, residuals: np.ndarray, alpha: float = 0.10) -> tuple[np.ndarray, np.ndarray, float]:
    residuals = np.abs(np.asarray(residuals, dtype=float))
    residuals = residuals[np.isfinite(residuals)]
    if not len(residuals):
        # No calibration sample: deliberately return NaNs rather than inventing precision.
        nan = np.full_like(ensemble, np.nan, dtype=float)
        return nan, nan, float("nan")
    n = len(residuals)
    rank = min(n, int(np.ceil((n + 1) * (1 - alpha))))
    q = float(np.sort(residuals)[rank - 1])
    return ensemble - q, ensemble + q, q


def run_ensemble_forecast(
    ticker: str,
    stock_df: pd.DataFrame,
    horizon: int,
    weights: Optional[dict] = None,
) -> Optional[dict]:
    close = get_close_series(stock_df).dropna()
    if len(close) < 60:
        return None

    enable_lstm = os.getenv("MARKET_FORECASTER_ENABLE_LSTM", "false").lower() in {"1", "true", "yes"}
    validation = _validate(close, enable_lstm=enable_lstm, initial_weights=weights)

    forecaster = EnsembleForecaster(weights, enable_lstm=enable_lstm)
    forecaster.validation_errors = validation.errors
    forecaster.fit_all(close)
    ensemble, individual, learned_weights = forecaster.predict_ensemble(horizon)
    if ensemble is None:
        return None

    lower, upper, conformal_q = _conformal_interval(ensemble, validation.residuals)

    last_date = pd.Timestamp(stock_df["Date"].max()) if "Date" in stock_df.columns else pd.Timestamp.now().normalize()
    freq = infer_forecast_freq(ticker, "1d")
    future_dates = pd.date_range(start=last_date + pd.Timedelta(days=1), periods=horizon, freq=freq)

    return {
        "ensemble": ensemble,
        "individual": individual,
        "lower": lower,
        "upper": upper,
        "dates": future_dates,
        "models_used": list(individual),
        "weights": learned_weights,
        "validation_errors_smape": validation.errors,
        "validation_size": validation.size,
        "interval_method": "split_conformal_absolute_residual_90pct" if validation.size else "unavailable",
        "interval_half_width": conformal_q,
    }
